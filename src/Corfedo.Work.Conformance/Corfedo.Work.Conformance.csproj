<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Conformance suite for Corfedo Work store providers, on xUnit v3: a provider's own tests run its scenarios to show the guarantees the store contract requires.</Description>
    <PackageTags>$(PackageTags);testing;xunit</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Corfedo.Work/Corfedo.Work.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
