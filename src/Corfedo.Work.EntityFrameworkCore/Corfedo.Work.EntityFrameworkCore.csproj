<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Entity Framework Core adapter for Corfedo Work: maps lease and reconciliation fields onto entities, joins work operations and signals to a DbContext's transaction and wakes claimers when saved changes make records due.</Description>
    <PackageTags>$(PackageTags);entity-framework-core;efcore</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Corfedo.Work/Corfedo.Work.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
