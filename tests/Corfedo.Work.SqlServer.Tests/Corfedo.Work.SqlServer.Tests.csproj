<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <None Include="../xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Corfedo.Work.SqlServer/Corfedo.Work.SqlServer.csproj" />
    <ProjectReference Include="../../src/Corfedo.Work.Conformance/Corfedo.Work.Conformance.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <Using Include="Xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- SqlClient's channel-based pool: a new connection's login delays only the open that makes it, not every open
         queued behind it, as the production guide recommends. -->
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseConnectionPoolV2" Value="true" />
  </ItemGroup>
</Project>
